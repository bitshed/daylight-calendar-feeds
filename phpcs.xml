<?xml version="1.0"?>
<ruleset name="daylight-calendar-feeds">
    <description>PSR-12.</description>
    <file>src</file>
    <file>tests</file>
    <file>bin/build</file>
    <file>config.php</file>
    <file>templates</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12"/>
    <!-- Templates are HTML with PHP islands; long markup lines are expected. -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>templates/*</exclude-pattern>
    </rule>
    <!-- Pest test files declare closures, not classes. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tests/*</exclude-pattern>
        <exclude-pattern>templates/*</exclude-pattern>
    </rule>
</ruleset>
